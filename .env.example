# OK to Intro · environment. Copy to .env.local and fill in what you have; every feature switches on when its
# variables appear and shows its designed "not configured" state until then. Never commit real values.

# Origin of the deployed site (no trailing slash), e.g. https://ok-to-intro.vercel.app. Every absolute URL, install
# command, email link and receipt derives from it. Defaults to the Vercel production domain, then http://localhost:3200.
NEXT_PUBLIC_SITE_URL=

# Optional contact address for /privacy (e.g. on the domain mail is sent from). Without it, /privacy links to the
# repo's issues until the site runs on its own product domain.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase project URL and anon key: email-code sign-in and user-scoped reads (RLS applies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key: server-side writes (members, asks, offers, the board). Server only, never exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for live gates (claude-haiku-5-5) and the compiler (claude-sonnet-5-5). Use a dedicated
# workspace with its own spend limit.
ANTHROPIC_API_KEY=

# Resend API key and the sender, e.g. "OK to Intro (Alan Arguello) <asks@mail.yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Bearer secret Vercel Cron sends to /api/cron/daily (16+ characters).
CRON_SECRET=

# HMAC key for email-link and API tokens (32+ characters). Only the HMAC of a token is stored.
TOKEN_HMAC_SECRET=

# Secret for the daily salt of rate-limit keys, HMAC(ip, salt); raw IPs are never stored (16+ characters).
RATE_LIMIT_SALT_SECRET=

# App-level daily model budget in USD, kept below the Anthropic workspace limit. Default 10.
DAILY_BUDGET_USD=

# Who may ask the REAL network. Unset, empty or * = every signed-in member (the launch default). A comma-separated
# list of emails = only those (seeded into the real_askers table by the server). Gates, caps and limits apply either way.
REAL_ASKERS=

# Set to 1 to honour ?state= and ?degraded= QA states (and /kit) in a production build. Always on in development.
QA_STATES=
